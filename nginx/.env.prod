# ============================================
# Variables de Entorno - PRODUCCIÓN
# ============================================
# Este archivo debe estar en /root/docker/masas-estacion/nginx/ en el VPS

# Base de Datos PostgreSQL (usa el existente)
DB_USER=fme
DB_PASSWORD=fme
DB_NAME=fme_database

# Timezone
TZ=America/Santiago

# Email para Let's Encrypt (cambiar por email real)
LETSENCRYPT_EMAIL=contacto@masasestacion.cl
